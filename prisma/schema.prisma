datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Player {
  id              String              @id @default(cuid())
  fullName        String              @map("full_name")
  birthDate       DateTime?           @map("birth_date")
  nationality     String?
  position        String?
  marketValueEur  Int?                @map("market_value_eur")
  popularityScore Int                 @default(0) @map("popularity_score")
  externalRef     String?             @unique @map("external_ref")
  kaggleId        String?             @unique @map("kaggle_id")
  wikidataId      String?             @unique @map("wikidata_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  teamsHistory    PlayerTeamHistory[]

  @@index([popularityScore])
  @@map("players")
}

model Team {
  id              String              @id @default(cuid())
  name            String
  country         String
  league          String?
  logoUrl         String?             @map("logo_url")
  popularityScore Int                 @default(0) @map("popularity_score")
  externalRef     String?             @unique @map("external_ref")
  aliases         String[]            @default([])
  createdAt       DateTime            @default(now()) @map("created_at")
  playersHistory  PlayerTeamHistory[]

  @@index([popularityScore])
  @@map("teams")
}

model PlayerTeamHistory {
  id             String   @id @default(cuid())
  playerId       String   @map("player_id")
  teamId         String   @map("team_id")
  seasonStart    Int?     @map("season_start")
  seasonEnd      Int?     @map("season_end")
  isNationalTeam Boolean  @default(false) @map("is_national_team")
  player         Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team           Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([playerId, teamId])
  @@index([playerId, teamId])
  @@index([teamId])
  @@map("player_team_history")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  eloRating    Int      @default(1000) @map("elo_rating")
  rankTier     String   @default("bronze") @map("rank_tier")
  matchesWon   Int      @default(0) @map("matches_won")
  matchesLost  Int      @default(0) @map("matches_lost")
  matchesDraw  Int      @default(0) @map("matches_draw")
  currentStreak Int     @default(0) @map("current_streak")
  bestStreak   Int      @default(0) @map("best_streak")
  lastSeenAt    DateTime? @map("last_seen_at")
  currentStatus String   @default("offline") @map("current_status")
  isGuest       Boolean  @default(false) @map("is_guest")
  coins         Int      @default(0)
  alimCoins     Int      @default(0) @map("alim_coins")
  createdAt     DateTime @default(now()) @map("created_at")

  sentFriendships     Friendship[]      @relation("SentFriendships")
  receivedFriendships Friendship[]      @relation("ReceivedFriendships")
  inventory           UserInventory[]
  coinTransactions    CoinTransaction[]

  @@map("users")
}

model Match {
  id           String       @id @default(cuid())
  player1Id    String       @map("player1_id")
  player2Id    String       @map("player2_id")
  player1Score Int          @default(0) @map("player1_score")
  player2Score Int          @default(0) @map("player2_score")
  winnerUserId     String?      @map("winner_user_id")
  player1EloChange Int?         @map("player1_elo_change")
  player2EloChange Int?         @map("player2_elo_change")
  mode             String       @default("team_vs_team")
  ranked           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  rounds       MatchRound[]

  @@index([player1Id, player2Id])
  @@map("matches")
}

model MatchRound {
  id           String    @id @default(cuid())
  matchId      String    @map("match_id")
  roundNumber  Int       @map("round_number")
  entity1Id    String    @map("entity1_id")
  entity1Type  String    @default("team") @map("entity1_type")
  entity2Id    String    @map("entity2_id")
  entity2Type  String    @default("team") @map("entity2_type")
  winnerUserId String?   @map("winner_user_id")
  answerGiven  String?   @map("answer_given")
  answeredAt   DateTime? @map("answered_at")
  timeTakenMs  Int?      @map("time_taken_ms")
  match        Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@map("match_rounds")
}

model MissingAnswerLog {
  id               String   @id @default(cuid())
  normalizedAnswer String   @map("normalized_answer")
  team1Id          String   @map("team1_id")
  team2Id          String   @map("team2_id")
  attemptCount     Int      @default(1) @map("attempt_count")
  lastAttemptAt    DateTime @updatedAt @map("last_attempt_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([normalizedAnswer, team1Id, team2Id])
  @@map("missing_answers_log")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String           @map("sender_id")
  receiverId String           @map("receiver_id")
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  sender     User             @relation("SentFriendships", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User             @relation("ReceivedFriendships", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("friendships")
}

enum CurrencyType {
  COIN
  ALIM_COIN
}

enum TransactionType {
  MATCH_REWARD
  ITEM_PURCHASE
  AC_PURCHASE
  DAILY_BONUS
  ADMIN_ADJUSTMENT
}

model StoreItem {
  id           String          @id @default(cuid())
  name         String
  category     String          // "frame" | "title" | "theme"
  price        Int
  currency     CurrencyType    @default(COIN)
  description  String
  previewColor String?         @map("preview_color")
  badgeText    String?         @map("badge_text")
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at")
  owners       UserInventory[]

  @@map("store_items")
}

model UserInventory {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  itemId     String    @map("item_id")
  isEquipped Boolean   @default(false) @map("is_equipped")
  acquiredAt DateTime  @default(now()) @map("acquired_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_inventory")
}

model CoinTransaction {
  id           String          @id @default(cuid())
  userId       String          @map("user_id")
  amount       Int             // Pozitif kazanç veya negatif harcama
  currency     CurrencyType
  type         TransactionType
  balanceAfter Int             @map("balance_after")
  description  String?
  referenceId  String?         @map("reference_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("coin_transactions")
}
