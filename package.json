{
  "name": "football-quiz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "concurrently -n \"next,party\" -c \"cyan,magenta\" \"next dev -H 0.0.0.0 -p 5000\" \"tsx watch party/server.ts\"",
    "dev:next": "next dev -H 0.0.0.0 -p 5000",
    "party": "tsx watch party/server.ts",
    "build": "prisma generate && tsx scripts/guard-logo-urls.ts && tsx scripts/generate-static-player-index.ts && next build",
    "guard:logos": "tsx scripts/guard-logo-urls.ts",
    "generate:index": "tsx scripts/generate-static-player-index.ts",
    "start": "next start -H 0.0.0.0 -p 5000",
    "party:deploy": "partykit deploy",
    "lint": "eslint",
    "verify:sim": "tsx scripts/verify-sim-weights.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "framer-motion": "^13.1.1",
    "fuse.js": "^7.5.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "partysocket": "^1.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.32.0",
    "@types/ws": "^8.18.1",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "partykit": "^0.0.115",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
